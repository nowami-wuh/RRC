MYSQL_HOST=your-aiven-host
MYSQL_PORT=your-aiven-port
MYSQL_USER=your-aiven-user
MYSQL_PASSWORD=your-aiven-password
MYSQL_DATABASE=your-aiven-database
MYSQL_SSL=true
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Required only for a deliberate first-admin bootstrap; never use a shared default.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_FULL_NAME=

# Comma-separated exact browser origins. Do not leave this unset in production.
CORS_ORIGINS=https://your-client.example

# Local testing against an existing database; prevents seed/migration startup work.
SKIP_DATABASE_BOOTSTRAP=true

# Configure an external monitor to request https://your-api.example/healthz
# every 10-14 minutes if using Render's free web service.
